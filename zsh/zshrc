# --- Lazy-load completions for heavy CLI tools ---
# kubectl
if command -v kubectl >/dev/null 2>&1; then
  function kubectl() {
    unfunction kubectl
    source <(command kubectl completion zsh)
    command kubectl "$@"
  }
fi

# podman
if command -v podman >/dev/null 2>&1; then
  function podman() {
    unfunction podman
    source <(command podman completion zsh)
    command podman "$@"
  }
fi

export XDG_CONFIG_HOME=$HOME/.config


set -o vi

vv() {
    if [ -z "$1" ]; then
	fzf  --walker-skip=.git,.venv,node_modules,.idea --walker-root=${HOME}/projects --bind 'enter:become(vim {})'
	else
		nvim "$@"
	fi
}
alias cdp='cd ~/projects/'

# Update PS1 to include the Git branch on the right
function pc {
  #[ -d .git ] && git name-rev --name-only @
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

PS1='\e];\s\a\n\e[33m\w \e[36m$(pc)\e[m\n$ '
