# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

zmodload zsh/zprof
# ZSH options

setopt glob_dots  
setopt extended_glob  

setopt append_history


# --- ZSH exports ---

export MYVIMRC=~/.config/nvim/init.lua
export YAZI_CONFIG_HOME=~/.config/yazi

# --- Completion init (must run before any compdef callers) ---
if [[ -d ~/.oh-my-zsh/custom/completions ]]; then
  fpath=(~/.oh-my-zsh/custom/completions $fpath)
fi
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# ----- ZSH autocompletion & syntax highlighting -----
if [[ -n "${ZSH_AUTOSUGGESTIONS_DIR:-}" ]] && [[ -r "${ZSH_AUTOSUGGESTIONS_DIR}/zsh-autosuggestions.zsh" ]]; then
  source "${ZSH_AUTOSUGGESTIONS_DIR}/zsh-autosuggestions.zsh"
elif [[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

if [[ -n "${ZSH_SYNTAX_HIGHLIGHTING_DIR:-}" ]] && [[ -r "${ZSH_SYNTAX_HIGHLIGHTING_DIR}/zsh-syntax-highlighting.zsh" ]]; then
  source "${ZSH_SYNTAX_HIGHLIGHTING_DIR}/zsh-syntax-highlighting.zsh"
elif [[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# completion using arrow keys (based on history)
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward


# ----- Bat (better cat) -----

export BAT_THEME=tokyonight_night


# ---- Zoxide (better cd) ----
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd="z"
fi


# Set up fzf key bindings and fuzzy completion
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

# --- setup fzf theme ---
fg="#CBE0F0"
bg="#011628"
bg_highlight="#143652"
purple="#B388FF"
blue="#06BCE4"
cyan="#2CF9ED"

export FZF_DEFAULT_OPTS="--color=fg:${fg},bg:${bg},hl:${purple},fg+:${fg},bg+:${bg_highlight},hl+:${purple},info:${blue},prompt:${cyan},pointer:${cyan},marker:${cyan},spinner:${cyan},header:${cyan}"



# --- Aliases ---
alias vi='nvim'
alias vim='nvim'
alias eza='eza --icons=always'
alias ltr='eza -aolrt=modified --icons'
alias ll='eza -la --icons'
alias nvc='nvim ~/.config/nvim/init.lua'
alias tx='cd "$PROJECTS" && tmux'


# --- Random vars ---
export EDITOR=nvim

# Project directory (respect external volume if present, fallback cleanly to ~/projects)
if [[ -d "/Volumes/work/projects" ]]; then
  export PROJECTS="/Volumes/work/projects"
else
  export PROJECTS="${PROJECTS:-$HOME/projects}"
fi

export PATH="$PATH:$HOME/.local/bin:$HOME/.lmstudio/bin:$HOME/.cargo/bin"

# --- Completion styles ---
zstyle ':completion:*' completer _complete _ignored _approximate
zstyle :compinstall filename '$HOME/.zshrc'

# --- Lazy-load completions for heavy CLI tools ---
# kubectl
if command -v kubectl >/dev/null 2>&1; then
  function kubectl() {
    unfunction kubectl
    source <(command kubectl completion zsh)
    command kubectl "$@"
  }
fi

# podman
if command -v podman >/dev/null 2>&1; then
  function podman() {
    unfunction podman
    source <(command podman completion zsh)
    command podman "$@"
  }
fi

export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

set -o vi

vv() {
    if [ -z "$1" ]; then
        fzf --walker-skip=.git,.venv,node_modules,.idea --walker-root="${PROJECTS}" --bind 'enter:become(nvim {})'
    else
        nvim "$@"
    fi
}
alias cdp='cd "$PROJECTS"'

# --- Git aliases ---
alias gcm='git commit -m'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gpl='git pull'
alias gf='git fetch'
alias gplr='git pull --rebase'
alias glg='git log --oneline --graph --decorate'
alias gss='git status -s'
alias gd='git diff'
alias gph='git push'
alias gpsu='git push --set-upstream origin $(git rev-parse --abbrev-ref HEAD)'
alias gbr='git branch'
alias gad='git add'

alias ansible-lint='uv run ansible-lint'

# Kubernetes aliases
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgd='kubectl get deployments'
alias kgn='kubectl get nodes'
alias kdp='kubectl describe pod'
alias kl='kubectl logs'
alias klf='kubectl logs -f'
alias kex='kubectl exec -it'
alias kctx='kubectl config use-context'
alias kns='kubectl config set-context --current --namespace'

alias g=git
alias k=kubectl
alias p=podman

function kube_prompt() {
  local context=$(kubectl config current-context 2>/dev/null)
  local namespace=$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null)
  [[ -n $context ]] && echo " ☸️  $context${namespace:+:$namespace}"
}

# --- Cross-platform clipboard support (macOS pbcopy vs Linux wl-copy / xclip) ---
if ! command -v pbcopy >/dev/null 2>&1; then
  if command -v wl-copy >/dev/null 2>&1; then
    alias pbcopy='wl-copy'
    alias pbpaste='wl-paste'
  elif command -v xclip >/dev/null 2>&1; then
    alias pbcopy='xclip -selection clipboard'
    alias pbpaste='xclip -selection clipboard -o'
  fi
fi

alias ssh-osum='pass osum | pbcopy && ssh'

# --- AnythingLLM / LanceDB paths ---
if [[ -d "$HOME/Library/Application Support/anythingllm-desktop/storage/lancedb" ]]; then
  export LANCEDB_URI="$HOME/Library/Application Support/anythingllm-desktop/storage/lancedb"
elif [[ -d "$HOME/.config/anythingllm-desktop/storage/lancedb" ]]; then
  export LANCEDB_URI="$HOME/.config/anythingllm-desktop/storage/lancedb"
fi
export LANCEDB_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

export LLM_USER_PATH=~/.config/io.datasette.llm
export VAULT_ADDR=https://po-zookeeper-vault.poinfra.server.lan:8200/

alias ls='ls -la'

# --- Vault completion (dynamic check) ---
if command -v vault >/dev/null 2>&1; then
  autoload -U +X bashcompinit && bashcompinit
  complete -o nospace -C "$(command -v vault)" vault
fi

# --- Powerlevel10k theme initialization ---
if [[ -n "${POWERLEVEL10K_DIR:-}" ]] && [[ -r "${POWERLEVEL10K_DIR}/powerlevel10k.zsh-theme" ]]; then
  source "${POWERLEVEL10K_DIR}/powerlevel10k.zsh-theme"
elif [[ -r /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
elif [[ -r /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
